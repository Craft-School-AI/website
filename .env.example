# Скопируйте этот файл в .env.local и заполните значения.
# Как получить токены — см. README.md, раздел «Настройка ВКонтакте».

# Ключ доступа сообщества с правом «Управление сообщениями сообщества»
# (Управление → Настройки → Работа с API → Ключи доступа)
VK_ACCESS_TOKEN=

# Числовой VK id получателя заявок (свой id — на vk.com/settings)
VK_PEER_ID=

# Версия VK API (по умолчанию 5.199, менять обычно не нужно)
VK_API_VERSION=5.199

# Публичный URL сайта (для SEO и Open Graph)
NEXT_PUBLIC_SITE_URL=https://craft-school.ru

# ID счётчика Яндекс.Метрики. Если не задан — счётчик и cookie-баннер
# не подключаются вовсе.
YANDEX_METRIKA_ID=
